# Copy this file to .env and adjust for your local environment.
APP_NAME="Data Verification Dashboard (Demo)"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8001

# Database (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dvd_demo
DB_USER=dvd_demo
DB_PASS=change_me_locally

# Max CSV upload size in rows (safety limit for the demo)
IMPORT_MAX_ROWS=5000
